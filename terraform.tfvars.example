# Example variable values for local use and review.
#
# Every value below is fictional. Copy this file to terraform.tfvars and
# replace the values with your own. terraform.tfvars is git-ignored on purpose.
#
#   cp terraform.tfvars.example terraform.tfvars
#   terraform init -backend-config=backend.hcl
#   terraform plan -out=tfplan

# Scope of this deployment: REGIONAL protects an ALB in aws_region; CLOUDFRONT
# creates the global ACL (us-east-1 only) to be attached by the distribution.
waf_scope = "REGIONAL"

# Region of the existing ALB. The Web ACL, the Firehose stream, and the log
# bucket must all be in this Region.
aws_region = "eu-west-1"

# ARN of the ALB that already exists. This project never creates or changes the
# ALB, and it never discovers an ARN on its own.
alb_arn = "arn:aws:elasticloadbalancing:eu-west-1:123456789012:loadbalancer/app/example-alb/0123456789abcdef"

# Name of the existing bucket that receives the WAF logs through Firehose.
# The bucket must already exist in aws_region, with encryption, Block Public
# Access, and a policy that lets the Firehose role write to it.
log_bucket_name = "example-waf-logs-123456789012"

# Base name for the Web ACL, rules, IP sets, Firehose stream, and log group.
# Effective names are <name_prefix>-<scope>-<region>-<suffix>, for example
# waf-alb-regional-eu-west-1-web-acl. Keep it at most 24 characters.
name_prefix = "waf-alb"

# default_action = "block" only after you are confident in the rules.
default_action = "allow"

# COUNT only observes and records matches. Promote to BLOCK with a new plan and
# a new approval in both pipelines.
#
# Per-rule promotion, for example only rate limiting:
#   rule_actions = { rate_limit = "BLOCK" }
#
# In the pipelines the policy comes from env/<region>.tfvars, not from this file.
rule_mode    = "COUNT"
rule_actions = {}

# Rules that exist in this deployment. Remove a name to leave that rule out.
enabled_rules = [
  "ip_allowlist",
  "ip_denylist",
  "managed_common",
  "managed_known_bad_inputs",
  "geo",
  "rate_limit",
]

rate_limit                       = 2000
rate_limit_evaluation_window_sec = 300

# Optional lists. Leave them empty to skip the corresponding rules.
ip_allow_list            = ["203.0.113.0/24"]
ip_deny_list             = ["198.51.100.0/24"]
geo_restricted_countries = ["KP"]

# Per-rule overrides for false-positive tuning. Example:
#   common_rule_set_rule_overrides = {
#     SizeRestrictions_BODY = "COUNT"
#   }
common_rule_set_rule_overrides     = {}
known_bad_inputs_rule_overrides    = {}

enable_waf_logging          = true
waf_log_redacted_headers    = ["authorization", "cookie"]
firehose_buffering_size     = 5
firehose_buffering_interval = 300
firehose_log_retention_days = 14

tags = {
  Environment = "portfolio"
  Owner       = "platform-team"
}
